# Copy to .env.local and fill in. Never commit real values.

# App database (Neon "dev" branch locally; set per environment in Vercel).
# Pooled connection: the host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct (unpooled) connection to the same branch, used for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Signs session cookies (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public origin of the app. Optional locally (defaults to http://localhost:3000);
# on Vercel it falls back to the deployment URL.
BETTER_AUTH_URL=""

# AI grading drafts. "gemini" (default) needs GOOGLE_GENERATIVE_AI_API_KEY; without a key the
# AI buttons are hidden and manual grading still works. "mock" is for tests (no network).
AI_PROVIDER="gemini"
# Create a key at https://aistudio.google.com/apikey. Never commit it.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Optional. A stable Gemini Flash model on the free tier (default: gemini-3.5-flash-lite).
GEMINI_MODEL=""
# Optional. Most AI drafts one course may start per UTC day (default: 200).
AI_DAILY_CAP_PER_COURSE=""

# Authorises the daily demo-reset cron (Vercel sends "Authorization: Bearer <CRON_SECRET>").
# Min 32 chars. Only needed in production. Generate: openssl rand -base64 32
CRON_SECRET=""

# Disposable database for integration tests (Neon "test" branch). It is wiped on every run.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-yyyy.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
